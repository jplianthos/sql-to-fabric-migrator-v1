{
  "version": 1,
  "hooks": {
    "sessionEnd": [
      {
        "type": "command",
        "powershell": "& (Join-Path $env:COPILOT_PLUGIN_ROOT 'com.github.copilot\\hooks\\guard.ps1') -Event sessionEnd",
        "timeoutSec": 30
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "powershell": "& (Join-Path $env:COPILOT_PLUGIN_ROOT 'com.github.copilot\\hooks\\guard.ps1') -Event sessionStart",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "powershell": "& (Join-Path $env:COPILOT_PLUGIN_ROOT 'com.github.copilot\\hooks\\guard.ps1') -Event preToolUse",
        "timeoutSec": 30
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "powershell": "& (Join-Path $env:COPILOT_PLUGIN_ROOT 'com.github.copilot\\hooks\\guard.ps1') -Event postToolUseFailure",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "powershell": "& (Join-Path $env:COPILOT_PLUGIN_ROOT 'com.github.copilot\\hooks\\guard.ps1') -Event postToolUse",
        "timeoutSec": 30
      }
    ]
  }
}
