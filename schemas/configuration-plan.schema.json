{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s2f.invalid/schemas/configuration-plan.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "kind", "planId", "runId", "project", "actionClass", "createdAt", "expiresAt", "baseHash", "payloadHash", "payload", "changedOptions", "target", "identityHint", "objects", "estimatedRows", "reversible", "calls"],
  "properties": {
    "contractVersion": {"const": "1.0"}, "kind": {"const": "configuration"},
    "planId": {"type": "string"}, "runId": {"const": "session"}, "project": {"type": "string"},
    "actionClass": {"const": "Write"}, "createdAt": {"$ref": "#/$defs/time"}, "expiresAt": {"$ref": "#/$defs/time"},
    "baseHash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}, "payloadHash": {"$ref": "#/$defs/hash"},
    "payload": {"$ref": "config.schema.json"}, "changedOptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "target": {"const": "migration.config.yaml"}, "identityHint": {"type": "string", "minLength": 1},
    "objects": {"const": ["migration.config.yaml"]}, "estimatedRows": {"const": 0}, "reversible": {"const": false},
    "calls": {"type": "array", "minItems": 1, "maxItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["operation", "path", "contentSha256"],
      "properties": {"operation": {"const": "atomic-replace"}, "path": {"const": "migration.config.yaml"}, "contentSha256": {"$ref": "#/$defs/hash"}}
    }}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"}
  }
}
