{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s2f.invalid/schemas/inventory.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "runId", "configHash", "databases", "objects", "definitionsExtracted", "ssis", "coverage", "consistency"],
  "properties": {
    "contractVersion": {"const": "1.0"}, "runId": {"type": "string"},
    "configHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "definitionsExtracted": {"const": false}, "ssis": {"const": "deferred-not-inspected"},
    "coverage": {"const": "objects-columns-only"}, "consistency": {"const": "nontransactional"},
    "databases": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "compatibilityLevel", "collation", "state", "canViewDefinition", "canViewState"],
        "properties": {
          "name": {"type": "string"}, "compatibilityLevel": {"type": "integer", "minimum": 100},
          "collation": {"type": "string"}, "state": {"const": "ONLINE"},
          "canViewDefinition": {"const": 1}, "canViewState": {"enum": [0, 1, null]}
        }
      }
    },
    "objects": {
      "type": "array", "maxItems": 16000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "database", "objectId", "schemaName", "name", "objectType", "canSelect", "columns"],
        "properties": {
          "id": {"type": "string"}, "database": {"type": "string"},
          "objectId": {"type": "integer", "minimum": 1},
          "schemaName": {"type": "string"}, "name": {"type": "string"},
          "objectType": {"enum": ["U", "V", "P", "FN", "IF", "TF"]},
          "canSelect": {"enum": [0, 1, null]},
          "columns": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["ordinal", "name", "typeName", "maxLength", "precision", "scale", "nullable", "identityColumn", "computedColumn", "collation"],
              "properties": {
                "ordinal": {"type": "integer", "minimum": 1},
                "name": {"type": "string"}, "typeName": {"type": "string"},
                "maxLength": {"type": "integer", "minimum": -1},
                "precision": {"type": "integer", "minimum": 0, "maximum": 255},
                "scale": {"type": "integer", "minimum": 0, "maximum": 38},
                "nullable": {"type": "boolean"}, "identityColumn": {"type": "boolean"},
                "computedColumn": {"type": "boolean"}, "collation": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
