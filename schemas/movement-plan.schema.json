{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://s2f.invalid/schemas/movement-plan.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contractVersion","kind","planId","runId","project","createdAt","expiresAt","configHash","operation","actionClass","summary","identity","workspaces","objects","estimatedRows","reversible","calls","spec","artifact","subscription","reads"],
  "$defs":{
    "target":{
      "type":"object","additionalProperties":false,"required":["workspaceId","lakehouseId","tableName"],
      "properties":{"workspaceId":{"type":"string","format":"uuid"},"lakehouseId":{"type":"string","format":"uuid"},"tableName":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"}}
    },
    "request":{
      "oneOf":[
        {
          "type":"object","additionalProperties":false,"required":["kind","runId","checkId","identity","subscription","maxRows","queryTimeout"],
          "properties":{
            "kind":{"const":"data-movement"},"runId":{"$ref":"plan.schema.json#/$defs/identifier"},
            "checkId":{"$ref":"plan.schema.json#/$defs/identifier"},"identity":{"$ref":"plan.schema.json#/$defs/identity"},
            "subscription":{"type":"string","format":"uuid"},"maxRows":{"type":"integer","minimum":1,"maximum":100000},"queryTimeout":{"type":"integer","minimum":1,"maximum":60}
          }
        },
        {
          "type":"object","additionalProperties":false,"required":["kind","previousPlanId","target"],
          "properties":{"kind":{"const":"data-movement"},"previousPlanId":{"$ref":"plan.schema.json#/$defs/identifier"},"target":{"$ref":"#/$defs/target"}}
        },
        {
          "type":"object","additionalProperties":false,"required":["kind","previousPlanId","acknowledgeNonAtomicCreate"],
          "properties":{"kind":{"const":"data-movement"},"previousPlanId":{"$ref":"plan.schema.json#/$defs/identifier"},"acknowledgeNonAtomicCreate":{"const":true}}
        }
      ]
    }
  },
  "properties":{
    "contractVersion":{"const":"1.0"},"kind":{"const":"data-movement"},"planId":{"$ref":"plan.schema.json#/$defs/identifier"},
    "runId":{"$ref":"plan.schema.json#/$defs/identifier"},"project":{"type":"string","minLength":1},
    "createdAt":{"$ref":"plan.schema.json#/$defs/timestamp"},"expiresAt":{"$ref":"plan.schema.json#/$defs/timestamp"},
    "configHash":{"$ref":"plan.schema.json#/$defs/hash"},"operation":{"enum":["extract","upload","load"]},"actionClass":{"enum":["Write","Execute"]},
    "summary":{"type":"string","minLength":1,"maxLength":500},"identity":{"$ref":"plan.schema.json#/$defs/identity"},
    "workspaces":{"$ref":"plan.schema.json#/$defs/workspaces"},"objects":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"string"}},
    "estimatedRows":{"type":["integer","null"],"minimum":0,"maximum":100000},"reversible":{"const":false},
    "subscription":{"type":"string","format":"uuid"},"artifact":{"anyOf":[{"type":"null"},{"$ref":"movement-output.schema.json#/$defs/artifact"}]},
    "reads":{"type":"array","minItems":3,"maxItems":5,"items":{"type":"string"}},
    "spec":{
      "type":"object","additionalProperties":false,
      "required":["checkId","previousPlanId","extractPlanId","maxRows","queryTimeout","table","columns","keys","mode","target"],
      "properties":{
        "checkId":{"$ref":"plan.schema.json#/$defs/identifier"},"previousPlanId":{"type":["string","null"]},
        "extractPlanId":{"$ref":"plan.schema.json#/$defs/identifier"},"maxRows":{"type":"integer","minimum":1,"maximum":100000},
        "queryTimeout":{"type":"integer","minimum":1,"maximum":60},"table":{"$ref":"movement-output.schema.json#/$defs/table"},
        "columns":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"movement-output.schema.json#/$defs/column"}},
        "keys":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string"}},
        "mode":{"type":"object","additionalProperties":false,"required":["mode","predicate","rows"],"properties":{
          "mode":{"enum":["full","sample","schema-only"]},"predicate":{"type":"null"},"rows":{"type":["integer","null"],"minimum":1,"maximum":100000}
        }},
        "target":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/target"}]}
      }
    },
    "calls":{
      "type":"array","minItems":1,"maxItems":1,"items":{
        "type":"object","additionalProperties":false,"required":["workspaceId","itemId","operation","description","method","path","body"],
        "properties":{
          "workspaceId":{"type":"string","minLength":1},"itemId":{"type":"string"},"operation":{"enum":["create","update","execute"]},
          "description":{"type":"string","minLength":1},"method":{"enum":["LOCAL","PUT","POST"]},"path":{"type":"string","minLength":1},
          "body":{"type":"object"}
        }
      }
    }
  }
}
